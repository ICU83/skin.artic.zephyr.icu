<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi 22 (Piers) weather API compatibility layer.
     Weather.Data()/Weather.LastUpdated are primary. Legacy Window(Weather).Property()
     remains as a narrow fallback for providers that have not fully moved to the v22 API. -->
<includes>
    <variable name="Weather22_CurrentFanartCode">
        <value condition="!String.IsEmpty(Weather.Data(Current.FanartCode))">$INFO[Weather.Data(Current.FanartCode)]</value>
        <value>$INFO[Window(Weather).Property(Current.FanartCode)]</value>
    </variable>
    <variable name="Weather22_CurrentConditionIcon">
        <value condition="!String.IsEmpty(Weather.ConditionsIcon)">$INFO[Weather.ConditionsIcon]</value>
        <value condition="!String.IsEmpty(Weather.Data(Current.ConditionIcon))">$INFO[Weather.Data(Current.ConditionIcon)]</value>
        <value>$INFO[Window(Weather).Property(Current.ConditionIcon)]</value>
    </variable>
    <variable name="Weather22_CurrentTemperature">
        <value condition="!String.IsEmpty(Weather.Data(Current.Temperature))">$INFO[Weather.Data(Current.Temperature)]</value>
        <value>$INFO[Window(Weather).Property(Current.Temperature)]</value>
    </variable>
